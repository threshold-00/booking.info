{
  "permissions": {
    "allow": [
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git diff)",
      "Bash(git diff *)",
      "Bash(git log)",
      "Bash(git log *)",
      "Bash(git add *)",
      "Bash(grep *)",
      "Bash(cat *)",
      "Bash(ls)",
      "Bash(ls *)",
      "Bash(npx browser-sync *)",
      "Bash(lsof *)",
      "Bash(open http://localhost:*)"
    ],
    "ask": [
      "Bash(git push)",
      "Bash(git push *)",
      "Bash(git commit)",
      "Bash(git commit *)",
      "Bash(kill *)",
      "Bash(xargs kill *)"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(rm -fr *)",
      "Bash(git reset --hard)",
      "Bash(git reset --hard *)",
      "Bash(git clean -f)",
      "Bash(git clean -f *)",
      "Bash(git clean -fd)",
      "Bash(git clean -fd *)",
      "Bash(git clean -df)",
      "Bash(git clean -df *)",
      "Bash(git clean --force)",
      "Bash(git clean --force *)",
      "Bash(sudo *)"
    ]
  }
}
